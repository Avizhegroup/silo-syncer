{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SiloSync": {
    "PollIntervalMinutes": 1,
    "BatchSize": 50,
    "SqlServer": {
      "ConnectionString": "Server=.;Database=SiloSync;Trusted_Connection=True;TrustServerCertificate=True;",
      "MediaRootPath": "C:\\GalleryFiles"
    },
    "Sqlite": {
      "DatabasePath": "data\\SiloSync.db"
    },
    "Api": {
      "BaseUrl": "http://localhost:5000",
      "UploadEndpoint": "/api/files"
    }
  }
}
