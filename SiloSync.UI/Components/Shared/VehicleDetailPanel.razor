<MudPaper Class="pa-4 ma-2" Elevation="0" Outlined="true">
    <MudGrid Spacing="3">
        @foreach (var field in DetailFields)
        {
            string link = $"https://www.google.com/maps/search/?api=1&query={field.Value}";
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudLink Href="@link" 
                         StartIcon="@Icons.Material.Filled.Map" 
                         Target="_blank"
                         EndIcon="@Icons.Material.Filled.OpenInNew">@field.Label</MudLink>
            </MudItem>
        }
    </MudGrid>
    <MudDivider Class="my-4" />
    <VehicleImageGallery UsageId="@Record.SerialNumber" />
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public VehicleTagReportDto Record { get; set; } = default!;

    private IEnumerable<(string Label, string? Value)> DetailFields => new (string Label, string? Value)[]
    {
        ("مختصات جغرافیایی تأیید مدارک", Record.DocumentApprovalGeoCoordinates),
        ("مختصات جغرافیایی تأیید راهور", Record.TrafficPoliceApprovalGeoCoordinates),
        ("مختصات جغرافیایی تأیید پرس", Record.PressApprovalGeoCoordinates),
        ("مختصات جغرافیایی مرکز پذیرش", Record.ReceptionCenterLocation)
    };
}
